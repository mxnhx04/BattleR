# All of these are public by design (Privy's App ID and everything else
# here ends up inlined into the client bundle regardless — none of it is
# a secret), so this file ships the real values for the current deployment
# rather than being a template to fill in. Copy it to .env.local if you
# don't already have one.

NEXT_PUBLIC_PRIVY_APP_ID=

NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_DEPLOY_TX_HASH=
